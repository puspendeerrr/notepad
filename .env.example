# ==============================================================================
# Notepad Environment Variables (Production & Local Development)
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------

# Project URL (public - exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (public - exposed to browser)
# Recommended: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Fallback (optional legacy name):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Secret / Service Role Key (SERVER ONLY - NEVER expose with NEXT_PUBLIC_)
# Recommended: SUPABASE_SECRET_KEY (or legacy SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key
# Fallback (optional legacy name):
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Application Security
# ------------------------------------------------------------------------------

# Cryptographic pepper for HMAC-SHA-256 hashing of recovery keys.
# Generate a strong, random 32+ character string in production (keep private).
RECOVERY_KEY_PEPPER=change-this-to-a-long-random-secret-salt-key-in-production

# Canonical Application URL
NEXT_PUBLIC_APP_URL=https://notepad.puspender.in
